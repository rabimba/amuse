#!/usr/bin/env bash
set -e

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

# Ensure Node environment from NVM if present (unset conflicting prefix first)
if [ -s "$HOME/.nvm/nvm.sh" ]; then
  unset npm_config_prefix 2>/dev/null || true
  source "$HOME/.nvm/nvm.sh" >/dev/null 2>&1 || true
fi

BRIDGE="$DIR/bin/amuse-bridge"

if [ ! -f "$BRIDGE" ]; then
  echo "==> Amuse bridge binary not found. Compiling now..."
  bash "$DIR/scripts/build.sh"
fi

COMMAND="${1:-gui}"

case "$COMMAND" in
  gui|start)
    echo "==> Starting Amuse Ambient HUD (Double-tap Option to toggle HUD)..."
    exec "$BRIDGE"
    ;;
  tools)
    exec "$BRIDGE" tools
    ;;
  call)
    shift
    exec "$BRIDGE" call "$@"
    ;;
  config)
    shift
    if [ "$1" == "--key" ] && [ -n "$2" ]; then
      # Value passed via env, never interpolated into JS source (injection-safe)
      AMUSE_SET_VALUE="$2" node -e "
        import('$DIR/src/js/config.mjs').then(m => {
          m.saveConfig({ apiKey: process.env.AMUSE_SET_VALUE });
          console.log('API key saved successfully to ~/.amuse/config.json');
        });
      "
    elif [ "$1" == "--voice" ] && [ -n "$2" ]; then
      AMUSE_SET_VALUE="$2" node -e "
        import('$DIR/src/js/config.mjs').then(m => {
          m.saveConfig({ voice: process.env.AMUSE_SET_VALUE });
          console.log('Voice saved to ~/.amuse/config.json');
        });
      "
    else
      node -e "
        import('$DIR/src/js/config.mjs').then(m => {
          const cfg = m.loadConfig();
          console.log('Current Amuse Configuration:');
          console.log('  Model:', cfg.model);
          console.log('  Voice:', cfg.voice);
          console.log('  API Key:', cfg.apiKey ? (cfg.apiKey.slice(0, 8) + '...' + cfg.apiKey.slice(-4)) : '(not set)');
        });
      "
    fi
    ;;
  test)
    echo "=========================================="
    echo "           AMUSE SYSTEM TEST             "
    echo "=========================================="
    # Isolated HOME: connector tests must never touch real ~/.amuse state.
    TEST_HOME="$(mktemp -d /tmp/amuse-test-home.XXXXXX)"
    export HOME="$TEST_HOME"
    NOHIT="zz-nohit-$(date +%s)"
    FAILED=0

    run_check() {
      local label="$1"; shift
      local tool="$1"; shift
      local args="$1"; shift
      echo ""
      echo "==> $label"
      local out
      if ! out="$("$BRIDGE" call "$tool" "$args" 2>&1)"; then
        echo "FAIL: bridge call errored: $out"
        FAILED=1
        return
      fi
      echo "$out" | head -c 400
      echo ""
      # Must be valid JSON and must not be an "Unknown tool" error
      if ! printf '%s' "$out" | node -e "
        let s='';process.stdin.on('data',d=>s+=d).on('end',()=>{
          try{const j=JSON.parse(s); if(typeof j.error==='string'&&j.error.startsWith('Unknown tool')) process.exit(1); process.exit(0);}catch{process.exit(1)}
        });"; then
        echo "FAIL: invalid JSON or unknown tool"
        FAILED=1
      fi
    }

    run_check "1. Messages (read-only, no-hit query)" search_messages "{\"query\": \"$NOHIT\", \"limit\": 2}"
    run_check "2. Notes (read-only, no-hit query)" search_notes "{\"query\": \"$NOHIT\", \"limit\": 2}"
    run_check "3. Calendar (read-only)" get_calendar_events '{"days_ahead": 7}'
    run_check "4. Contacts (read-only)" search_contacts "{\"name\": \"$NOHIT\"}"

    echo ""
    echo "==> 5. Tool declarations"
    TOOLS_JSON="$("$BRIDGE" tools)"
    TOOL_COUNT="$(printf '%s' "$TOOLS_JSON" | node -e "let s='';process.stdin.on('data',d=>s+=d).on('end',()=>{try{console.log(JSON.parse(s).length)}catch{console.log(0)}})")"
    echo "Exposed tools: $TOOL_COUNT"
    if [ "$TOOL_COUNT" -lt 1 ]; then
      echo "FAIL: no tool declarations"
      FAILED=1
    fi

    echo ""
    echo "==> 6. Safety gates (dangerous tools must refuse without opt-in flags)"
    GATE_OUT="$("$BRIDGE" call computer_control_action '{"action":"run_command","target":"echo pwned"}' 2>&1 || true)"
    if printf '%s' "$GATE_OUT" | grep -q 'safety_gate'; then
      echo "PASS: run_command gated"
    elif printf '%s' "$GATE_OUT" | grep -q 'Unknown tool'; then
      echo "PASS: run_command not present on this platform"
    else
      echo "FAIL: run_command executed without AMUSE_ALLOW_SHELL: $GATE_OUT"
      FAILED=1
    fi

    rm -rf "$TEST_HOME"
    echo ""
    if [ "$FAILED" -ne 0 ]; then
      echo "AMUSE SYSTEM TEST: FAILED"
      exit 1
    fi
    echo "AMUSE SYSTEM TEST: PASSED"
    ;;
  e2e|all)
    shift || true
    exec bash "$DIR/run.sh" "$@"
    ;;
  help|--help|-h)
    echo "Amuse - Personal AI Agent powered by Gemini"
    echo ""
    echo "Usage:"
    echo "  amuse [start|gui]            Launch ambient floating HUD (Double-tap Option/Alt to toggle)"
    echo "  amuse e2e                    Run the complete end-to-end build, test, and live HUD pipeline"
    echo "  amuse config --key <KEY>     Set your Google AI Studio Gemini API Key"
    echo "  amuse config --voice <VOICE> Set Gemini Live voice (Puck, Charon, Kore, Fenrir, Aoede)"
    echo "  amuse test                   Run diagnostics on local connectors"
    echo "  amuse tools                  List Gemini tool declarations"
    echo "  amuse call <name> [json]     Directly invoke a local connector tool"
    echo ""
    ;;
  *)
    exec "$BRIDGE" "$@"
    ;;
esac
